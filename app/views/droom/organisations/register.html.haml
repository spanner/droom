%h1.pagetitle
  = t "registration.page_title"
%p
  = t "registration.intro"

- if @organisation.errors.any?
  %ul.errors
    - @organisation.errors.full_messages.each do |message|
      %li
        = message

= form_for [droom, @organisation], url: droom.propose_organisations_path, method: "post", html: {class: 'edit organisation signup'} do |f|
  = f.hidden_field :registration_email
  = f.hidden_field :registration_email_token

  %fieldset
    %h2
      =t :organisation_information

    - if Droom.config.use_chinese_names?
      %p.name.twocol<
        %span.col>
          = f.label :name
          %br
          = f.text_field :name, required: true, autofocus: true, placeholder: t("placeholders.organisation.registration_name")
        %span.col>
          = f.label :chinese_name
          %br
          = f.text_field :chinese_name, placeholder: t("placeholders.organisation.chinese_name")
    - else
      %p.name.onecol<
        %span.col>
          = f.label :name
          %br
          = f.text_field :name, required: true, autofocus: true, placeholder: t("placeholders.organisation.registration_name")

    %p.url.twocol<
      %span.col.first>
        = f.label :url
        %br
        = f.url_field :url, class: "url", placeholder: t("placeholders.organisation.registration_url")
      %span.col.last>
        = f.label :organisation_type_id
        %br
        = f.select :organisation_type_id, Droom::OrganisationType.for_selection, class: 'preferences'

    - if Droom.config.use_tags?
      %p.secondary.tagger
        = f.label :keywords
        %br
        = f.text_field :keywords, placeholder: t("placeholders.organisation.keywords"), class: "tags"

    %p.description.onecol<
      %span.col>
        = f.label :description
        %br
        = f.text_area :description, placeholder: t("placeholders.organisation.registration_description")

  = f.fields_for :owner, @user do |uf|
    %fieldset
      %h2
        =t "registration.owner"

      - if Droom.config.use_chinese_names?
        %p.names.threecol<
          %span.col.first>
            = uf.label :given_name
            %br
            = uf.text_field :given_name, required: true, placeholder: t("placeholders.user.given_name")
          %span.col>
            = uf.label :family_name
            %br
            = uf.text_field :family_name, required: true, placeholder: t("placeholders.user.family_name")
          %span.col.last>
            = uf.label :chinese_name
            %br
            = uf.text_field :chinese_name, placeholder: t("placeholders.user.chinese_name")
      - else
        %p.names.twocol<
          %span.col.first>
            = uf.label :given_name
            %br
            = uf.text_field :given_name, required: true, placeholder: t("placeholders.user.given_name")
          %span.col.last>
            = uf.label :family_name
            %br
            = uf.text_field :family_name, required: true, placeholder: t("placeholders.user.family_name")
        
      %p.contact.twocol<
        %span.col>
          = uf.label :email, class: "disabled"
          %br
          = f.text_field :registration_email, placeholder: t("placeholders.user.email"), disabled: true, value: CGI.unescapeURIComponent(@organisation.registration_email)
        %span.col>
          = uf.label :phone
          %br
          = uf.text_field :phone, placeholder: t("placeholders.user.phone")

      %p.formnote
        = t "registration.whatnext"

  .buttons
    = f.submit t("registration.submit")
    = t :or
    = link_to t(:cancel), "/", class: 'cancel'
